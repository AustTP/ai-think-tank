PAIR_KEY=
# Pairing-mode identities: which agent converses with the player and which
# coordinator receives the HANDOFF mail. Defaults theo/ruth; override only if
# the roster changes.
PAIR_AGENT_ID=
PAIR_COORDINATOR_ID=

# ---- Village mode (world/server/serve_parts/105_village_mode.py) ----
# Set on a village process (its launchd plist) to say WHICH village this
# process is; the parent leaves it unset.
THINK_TANK_VILLAGE=
# The parent's base URL for villages to reach cross-village APIs
# (195_cross_village_api.py relays; mail, visits, resources).
THINK_TANK_PARENT_URL=
# Shared secret villages present to the parent for resource leases and
# visitor returns (366_village_resources.py / 197_visits.py). Blank in
# the template on purpose: it is a credential.
THINK_TANK_PARENT_TOKEN=

# ---- First-boot roster seeding (090_lifespan.py / 020_backup) ----
# THINK_TANK_-prefixed overrides of the plain seed keys so a village
# process does not inherit the parent's roster identity through the
# shared .env file. Comma-separated agent ids (admin ids, director map
# entries agent:role), senior director id, and the seed roster spec.
THINK_TANK_SEED_ADMIN_IDS=
THINK_TANK_SEED_DIRECTOR_MAP=
THINK_TANK_SEED_ROSTER=
THINK_TANK_SEED_SENIOR_DIRECTOR=

# Read-only API-to-browser fallback for /api/browse: when the plain fetch
# of an already-approved URL dies with 404/410 (moved endpoint, SPA-only
# route), the SAME url is retried once through the headless browser the
# render path uses. No second, unvetted URL is ever fetched. Set to false
# to shut the fallback off entirely.
BROWSER_FALLBACK_ENABLED=true

# Tank Mission Control realtime sealing key. Optional: when unset, the seal
# key is derived from the deployment's DSN instead. Setting a fixed value
# keeps sealed capabilities valid across DSN changes.
MC_REALTIME_SECRET=
