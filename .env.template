# AI Think Tank — environment template
# ---------------------------------------------------------------------------
# Copy this file to `.env` (cp .env.template .env) and fill in the keys below.
# `.env` is gitignored and never committed. The server reads `.env` from the
# directory one level ABOVE `world/` (the repo root).
#
# On a genuinely fresh boot (no `.env` at all), the server auto-generates the
# per-install credentials below and prints them ONCE to stdout:
#   - ADMIN_USERNAME / ADMIN_PASSWORD_SALT / ADMIN_PASSWORD_HASH
#     (the first-run admin password — printed in the clear exactly once)
#   - SERVER_SECRET
# So you do NOT need to create the admin account yourself: just start the
# server and capture the printed password. Pre-creating `.env` lets you set
# these deterministically instead.
# ---------------------------------------------------------------------------

# --- External service keys (you must provide these; the server cannot invent
# --- real API keys for external services). Leave blank if you don't use the
# --- corresponding feature.

# OpenRouter API key — required for LLM agent calls (/api/chat, /api/decide).
# Get one at https://openrouter.ai. First token goes toward the def-4 prose
# model fallback and Jev's decide calls.
OPENROUTER_API_KEY=

# PixelLab credential is vault-held (credential name `pixellab`) -- see
# library/skills/pixellab.md. Do NOT put the key here.
# PIXELLAB_API_KEY=

# Apify API key — general-purpose web scraping/automation (run actors, fetch
# datasets). FREE plan: ~$5/mo usage cap, so check usage before large runs.
# Get one at https://console.apify.com/settings/integrations.
APIFY_API_KEY=

# Apify monthly budget — the FREE plan's real ~$5/mo usage cap. Surfaced in
# the Bank as its own row (used/cap/left) from day one; default 5.00. Set to
# 0 to hide the row entirely.
# APIFY_MONTHLY_BUDGET_USD=5.00

# GitHub PAT — read-only access to real repos/issues/PRs so the think tank's
# engineering work can ground itself in real code. Public API, no per-call
# spend. Create at https://github.com/settings/tokens.
GITHUB_TOKEN=

# Mullvad VPN — the durable credential is your account number (Mullvad has
# no per-call API key for this). The server logs the local `mullvad`
# CLI/app into this account automatically before any VPN-routed
# browse_page call, rather than depending on the host's interactive GUI
# session staying logged in. Requires the native Mullvad app/CLI installed
# on this host. This is real, host-wide shared state -- `mullvad connect`
# changes the WHOLE MACHINE's default route -- so it's off (empty
# allowlist) until you set a real account number below AND opt specific
# countries in AND complete a one-time host setup: exclude this server's
# own Python process from the tunnel via Mullvad's split-tunneling, e.g.
# `mullvad split-tunnel app add /path/to/python3`, found via
# `ps aux | grep serve.py`. Skipping that exclusion risks a connect mid-
# request silently affecting the server's OWN self-loopback calls
# (SELF_BASE_URL) for as long as the VPN window stays open.
# MULLVAD_ACCOUNT_NUMBER=
# MULLVAD_COUNTRY_ALLOWLIST=de,jp,br

# --- Per-install credentials -------------------------------------------------
# On first boot with no .env, the server generates these and writes them here.
# You can also pre-set them (see top of file). Admin password is stored as a
# salted PBKDF2 hash so no plaintext lives on disk.

# HMAC key for boundary markers. Auto-generated on first boot if absent.
SERVER_SECRET=

# --- Optional feature toggles / SMTP -----------------------------------------
# Agent-browsing gate. Set to false to disable agents making live web reads.
# AGENT_BROWSING_ENABLED=false

# Player-vetted browse allowlist: comma-separated domains that skip Jev's
# classify+escalate round trip for /api/browse entirely (SSRF/private-network
# protection still applies unconditionally). Leave blank/unset for no
# allowlist -- every browse then goes through full Jev policy-as-code. Also
# lets agent-run scripts in the sandbox reach these domains directly (the
# egress proxy can't restrict HTTPS methods) -- treat every entry as full
# read+write reachability, not just read access.
# BROWSE_ALLOWLIST_DOMAINS=example.com,another-example.com
# (the transcript tool's Colab runtime also touches api.apify.com -- the Apify
# platform API that downloads the YouTube audio -- so add it too when enabled)

# Hard absolute spend cap: once total NEW model/Jev spend (from the moment
# this is set) reaches this many dollars, every further real model call
# fails closed until you raise this value and restart. Unset defaults to a
# conservative $5 (a fresh think tank is bounded out of the box); explicit 0
# disables it.
# SPEND_CAP_USD=5

# Player notification email (vault-backed SMTP). The credential is provisioned
# at runtime via POST /api/player-email/credential with a Gmail app password;
# these env vars set the sending account defaults.
# AI_THINK_TANK_GMAIL_SMTP_EMAIL=you@gmail.com
# AI_THINK_TANK_GMAIL_SMTP_HOST=smtp.gmail.com
# AI_THINK_TANK_GMAIL_SMTP_PORT=587

# --- Publish to GitHub -------------------------------------------------------
# Player-triggered "Publish to GitHub" pushes the think tank's released work to
# this PRIVATE repo. Create the repo on GitHub first (keep it private), then
# set owner/repo here. Leave blank to disable the action with a clear error.
# AI_THINK_TANK_PUBLISH_REPO=owner/your-private-repo

# --- Seed roster (2026-09-27) ------------------------------------------------
# NO agent identities are hardcoded in the code or tracked in this repo -- they
# live only in THIS instance's .env and, once seeded, in think_tank.db. A fresh,
# empty database is seeded from these keys on first boot; an already-populated
# DB is never re-seeded. Leave them blank to boot with an empty think tank and add
# agents via hiring / the API instead.
#
# Default roster: comma-separated entries of  id|name|color|role|model
# SEED_ROSTER=ada|Ada|#e06666|Research|small,ben|Ben|#6fa8dc|Banking|small
#
# Director reporting map: comma-separated  id:directorId  pairs (who each
# worker reports up to). Agents not listed fall back to SEED_SENIOR_DIRECTOR.
# SEED_DIRECTOR_MAP=ada:theo,dev:theo,eli:theo,ben:nora,cora:nora
#
# The single admin (approves/denies on your behalf) and the senior-most
# director (stands in for the admin on routine approvals).
# SEED_ADMIN_IDS=theo
# SEED_SENIOR_DIRECTOR=nora
# --- Sandbox execution backend (2026-09-28) -----------------------------------
# Where agent commands actually run. `local` (the default) uses the local
# Docker sandbox -- the only tested backend. Set to `digitalocean` to route
# execution to a DigitalOcean Droplet instead. This ALSO gates the DigitalOcean
# credential: while it reads `local`, agents are hard-refused any use of the DO
# capability (no handle can be minted or resolved), so the DO key is
# unreachable until you flip this and restart. Local Docker is the safe,
# default-on state; flipping to digitalocean is a deliberate, paid decision.
# SANDBOX_EXECUTION=local
# --- YouTube no-captions transcript fallback (2026-10-01) ----------------------
# When a spike agent needs a YouTube video that has NO captions, the think tank
# falls back to downloading the audio ON a Google Colab runtime and transcribing
# it there with faster-whisper -- audio never touches this machine. YouTube
# bot-checks Colab's datacenter IPs, so that fallback needs your YouTube session
# cookies to authenticate the runtime's download. Export a Netscape-format
# cookies.txt (e.g. the "Get cookies.txt LOCALLY" browser extension) and point
# this at it (the repo-default `.youtube-cookies.txt` at the repo root is
# gitignored). Leave blank to disable the no-captions fallback (captions-based
# transcripts still work; no-captions videos return an honest error instead of a
# fabricated transcript).
# YOUTUBE_COOKIES_FILE=/path/to/youtube-cookies.txt
# --- High-tier budget controls (2026-09-27) -----------------------------------
# The high tier is the expensive one, chosen by JEV only for rare, high-stakes
# planning. Bound it twice:
#   HIGH_TIER_MAX_PRICE_USD   -- the daily refresh never offers a model priced
#                                above this ($/M tokens). 0/unset disables.
#   HIGH_TIER_MONTHLY_BUDGET_USD -- max TOTAL high-tier spend per calendar
#                                month; the JEV gate fails closed to mid once
#                                it's spent. 0/unset disables.
# HIGH_TIER_MAX_PRICE_USD=5.00
# HIGH_TIER_MONTHLY_BUDGET_USD=5.00
# --- Log retention ----------------------------------------------------------
# How many days of decision_tape / action_log rows to keep; the rolling prune
# also drops resolved escalations once they pass this window. Default is 7.
# LOG_RETENTION_DAYS=21
