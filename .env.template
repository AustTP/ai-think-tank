# AI Think Tank — environment template
# ---------------------------------------------------------------------------
# Copy this file to `.env` (cp .env.template .env) and fill in the keys below.
# `.env` is gitignored and never committed. The server reads `.env` from the
# directory one level ABOVE `world/` (the repo root).
#
# On a genuinely fresh boot (no `.env` at all), the server auto-generates the
# per-install credentials below and prints them ONCE to stdout:
#   - ADMIN_USERNAME / ADMIN_PASSWORD_SALT / ADMIN_PASSWORD_HASH
#     (the first-run admin password — printed in the clear exactly once)
#   - SERVER_SECRET
# So you do NOT need to create the admin account yourself: just start the
# server and capture the printed password. Pre-creating `.env` lets you set
# these deterministically instead.
# ---------------------------------------------------------------------------

# --- External service keys (you must provide these; the server cannot invent
# --- real API keys for external services). Leave blank if you don't use the
# --- corresponding feature.

# OpenRouter API key — required for LLM agent calls (/api/chat, /api/decide).
# Get one at https://openrouter.ai. First token goes toward the def-4 prose
# model fallback and Jev's decide calls.
OPENROUTER_API_KEY=

# Google AI Studio (Gemini) API key — free-tier source for the low band's free
# pool (world/model_providers.json free_pool). Get one at aistudio.google.com.
# Quotas are PER MODEL (each model has its own RPM/RPD/TPM budget).
# Straitly AI (straitly.ai) — alternative model catalog vendor with an
# OpenRouter-shaped /v1/models. Feeds the provider-agnostic catalog sync
# (model_provider_catalog); unset simply means the provider contributes
# nothing. jev-router (their vendor-side router) is never stored or used.
STRAITLY_API_KEY=

# Google AI Studio (Gemini) API key — free-tier source for the low band's free

# Groq Console API key — free-tier source for the low band's free pool.
# Get one at console.groq.com. Quotas are ORG-WIDE SHARED across models
# (one collective RPM bucket; tight per-model TPM), so the groq endpoints in
# free_pool share one pool_key.
GROQ_API_KEY=

# PixelLab credential is vault-held (credential name `pixellab`) — see
# library/skills/pixellab.md. Not read from .env.

# Tavily search API — lets the ask lane's search_web tool actually find a
# URL when it doesn't already know one (browse_page alone can only fetch a
# URL the model already guessed). Free tier, get one at tavily.com.
TAVILY_API_KEY=

# VirusTotal API key — URL reputation for the trust scorer (url_trust.py):
# N-engine verdicts feed the band that lets ordinary READS skip the Jev
# classify gate. Free tier: 500 lookups/day, 4/min. Get one at virustotal.com.
VIRUSTOTAL_API_KEY=

# Google Safe Browsing API key — the other keyed reputation source for
# url_trust.py (phishing/malware/unwanted-software verdicts). Free with a
# Google Cloud project; enable the Safe Browsing API.
SAFEBROWSING_API_KEY=

# Daily QUOTA budgets for the keyed URL-reputation sources above (url_trust.py).
# Count-based, reset at UTC midnight. A spent quota SKIPS that source and notes
# it in the URL verdict -- it never blocks a URL gate. 0 = unlimited.
VIRUSTOTAL_DAILY_BUDGET=400
SAFEBROWSING_DAILY_BUDGET=10000

# Apify API key — general-purpose web scraping/automation (run actors, fetch
# datasets). FREE plan: ~$5/mo usage cap, so check usage before large runs.
APIFY_API_KEY=
# Apify FREE-plan monthly budget — surfaced in the Bank; default 5.00.
APIFY_MONTHLY_BUDGET_USD=5.00

# GitHub fine-grained/classic PAT — read-only access to real repos/issues/PRs
# so the think tank's engineering work can ground itself in real code instead
# of hallucinating repos. Public API (no per-call spend), rate-limited by GitHub.
# Also the bearer credential for the GitHub MCP server (mcp_servers.json:
# "github", https://api.githubcopilot.com/mcp/) — needs repo+issues scopes
# for the issue/PR write tools. Values may be single- or double-quoted so
# `source .env` stays safe; the loader strips one matching quote pair.
GITHUB_TOKEN=

# Telegram bridge — lets the player text the think tank admin.
# TELEGRAM_ALLOWED_CHAT_IDS is a comma-separated allowlist of numeric chat ids;
# without it the bridge stays inactive even with a token set.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=

# Conversation memory (STM + LTM) for the Telegram chat — lets the admin answer
# follow-up questions in the context of the earlier exchange. STM stores each
# ask turn per chat and injects the recent turns + a rolling summary into the
# next ask (pruning the oldest when a session exceeds its budget). LTM distills
# durable facts/preferences/decisions from the conversation and recalls the
# relevant ones on each ask.
# MEMORY_ENABLED=true
# STM_MAX_TURNS=40        # stored message turns kept per chat session
# STM_MAX_TOKENS=8000     # token budget per session before the oldest turns prune
# STM_TTL_HOURS=168       # inactive sessions expire (7 days)
# LTM_MAX_RECALL=5        # long-term memories injected per ask
# LTM_MAX_PER_SESSION=200 # cap on stored long-term memories per session
# LTM_EXTRACT_EVERY_TURNS=6  # new turns between LTM extraction runs
# LTM_MIN_CONFIDENCE=0.3  # memories below this confidence are never recalled
# LTM_MAX_AGE_DAYS=180    # memories older than this are not recalled (0 = no cap)
# LTM_CONSOLIDATE_ENABLED=true   # periodically merge near-duplicate memories
# LTM_CONSOLIDATE_EVERY_TURNS=12 # new turns between consolidation runs
# LTM_CONSOLIDATE_MAX_CLUSTERS=4 # LLM merges per run (bounds spend)

# Mullvad VPN — the durable credential is the account number itself. The
# server logs the local `mullvad` CLI into this automatically before any
# VPN-routed browse_page call; the country allowlist below stays empty (feature
# off) until you've completed the one-time split-tunnel exclusion and picked
# which countries to allow.
MULLVAD_ACCOUNT_NUMBER=
MULLVAD_COUNTRY_ALLOWLIST=

# --- Per-install credentials -------------------------------------------------
# On first boot with no .env, the server generates these and writes them here.
# You can also pre-set them (see top of file). Admin password is stored as a
# salted PBKDF2 hash so no plaintext lives on disk.

# HMAC key for boundary markers. Auto-generated on first boot if absent.
SERVER_SECRET=

# --- Optional feature toggles / SMTP -----------------------------------------
# Agent-browsing gate. Set to false to disable agents making live web reads.
# AGENT_BROWSING_ENABLED=false

# Player-vetted browse allowlist: comma-separated domains that skip the Jev
# classify+escalate round trip entirely for /api/browse — SSRF/private-network
# protection still applies unconditionally. Everything NOT listed here still
# goes through full Jev policy-as-code, exactly as before. Also lets agent-run
# SCRIPTS in the sandbox reach these domains directly — treat every entry as
# full read+write reachability, not just read access.
BROWSE_ALLOWLIST_DOMAINS=

# Hard absolute spend cap. Baseline is spend at the moment this was installed —
# only NEW spend counts against it. Once hit, every real model/Jev call fails
# closed until this is raised and the server restarted. 0/unset disables it.
SPEND_CAP_USD=50

# Per-dialing-provider monthly spend caps (2026-11-13). Each vendor stops at
# its own ceiling; when one is exhausted the tier pick re-selects models from
# a provider with spend left, at the same evaluation-score and cost metrics
# per band. The JEV decisions model is EXCLUDED from the OpenRouter general
# cap and answers to JEV_SPEND_CAP_USD instead -- when that trips, decisions
# serve from the Colab/Laya standby first, then the free pool. 0 disables a cap.
OPENROUTER_SPEND_CAP_USD=5.00
JEV_SPEND_CAP_USD=0.50
STRAITLY_SPEND_CAP_USD=0.50
# Usage the provider cannot price. block holds that task's model budget until
# an operator resolves the receipt; allow keeps running.
UNPRICED_USAGE_POLICY=block
# Max concurrent content runs the dispatch governor allows. Each run holds a
# full state snapshot on its own thread; past ~24 the box saturates and the
# UI stops loading. Raise only on a bigger machine.
TANK_MAX_CONTENT_RUNS=24

# Optional override for durable plan revisions (defaults to THINK_TANK_DB).
# PLAN_APPROVALS_DB=

# MCP edge (POST /mcp): bearer token for EXTERNAL agents (a Claude Code
# session, a scratch CLI agent) to READ the board. Unset/empty = the edge is
# disabled (503) -- no token, no exposure. The tools are read-only
# projections (board_overview, list_cards, card_detail); nothing here moves
# a card.
# THINK_TANK_MCP_TOKEN=

# Live video coverage samples frames from a public stream and sends each frame
# to the vision tier. The per-run dollar ceiling is set on each run (default
# $0.25). Set this only for local test streams; it disables the public-host
# guard and lets coverage read private/loopback URLs.
# LIVE_COVERAGE_ALLOW_PRIVATE=0

# Expected total OpenRouter funding for the month — planning context for the
# /api/budget gauge only ("only $10 is in the account now, but I expect to add
# $50 this month"). NOT an alert trigger: the 80%/90% Telegram alerts fire on
# the LIVE deposited funds (percent of the account's total_credits actually
# spent), not on this number. Top-ups can be gradual; 0/unset just skips the
# plan line in the gauge.
OPENROUTER_MONTHLY_BUDGET_USD=

# Player notification email (vault-backed SMTP). The credential is provisioned
# at runtime via POST /api/player-email/credential with a Gmail app password;
# these env vars set the sending account defaults.
# AI_THINK_TANK_GMAIL_SMTP_EMAIL=you@gmail.com
# AI_THINK_TANK_GMAIL_SMTP_HOST=smtp.gmail.com
# AI_THINK_TANK_GMAIL_SMTP_PORT=587

# Player's call: Telegram only, no more email notifications. The email
# credential/outbox machinery stays intact — this just stops the actual send,
# so flipping it back to true needs no re-provisioning.
PLAYER_EMAIL_ENABLED=false

# --- Local training-example capture ----------------------------------------
# Opt-in recording of real model interactions (requests, replies, tool
# definitions, durations, failures) to a local SQLite DB, for building a
# fine-tuning dataset from the think tank's own runs. Off by default;
# recording is fail-open (never stops agent work) and redacts credentials
# before anything is written. See datasets/INTERACTION_RECORDING.md.
# TRAINING_CAPTURE_ENABLED=true
# TRAINING_CAPTURE_PATH=datasets/local/interactions/recordings.sqlite3
# TRAINING_CAPTURE_MAX_BYTES=8000000

# --- Publish to GitHub -------------------------------------------------------
# Player-triggered "Publish to GitHub" pushes the think tank's released work to
# this PRIVATE repo. Create the repo on GitHub first (keep it private), then
# set owner/repo here. Leave blank to disable the action with a clear error.
# AI_THINK_TANK_PUBLISH_REPO=owner/your-private-repo

# First-run admin account. Auto-generated if absent (printed once to stdout);
# pre-set these for a deterministic admin password.
ADMIN_USERNAME=
ADMIN_PASSWORD_SALT=
ADMIN_PASSWORD_HASH=

# The bound HOST:PORT for this instance — SELF_BASE_URL must match the real
# bound HOST:PORT or every self-loopback call (browse_page, /api/chat used by
# every content executor, assign-big-task, the schedule lane's field extraction,
# the security-test tools) silently fails with a connection refused. Must track
# whatever --host is actually passed, not stay hardcoded.
SELF_BASE_URL=http://127.0.0.1:8936

DEVICE_API_KEY=

# Seed roster: agent identities are no longer hardcoded in code; they come from
# these keys on a fresh-DB boot.
# Format: id|Name|#hexcolor|Room|model,...
SEED_ROSTER=
# Format: agentId:directorId,...
SEED_DIRECTOR_MAP=
SEED_ADMIN_IDS=
SEED_SENIOR_DIRECTOR=

# Sandbox execution backend. `local` (the default) runs agent commands in the
# local Docker sandbox — the only tested backend. Set to `digitalocean` to route
# execution to a DigitalOcean Droplet instead. This is ALSO the master gate for
# the DigitalOcean credential: while it reads `local`, agents are hard-refused
# any use of the DO capability, so DigitalOcean is unreachable until you flip
# this variable and restart. Never leave DO reachable while executing locally.
SANDBOX_EXECUTION=local

# High-tier controls: the high tier is the expensive one, so it's bounded twice —
# a per-model price ceiling the daily refresh won't exceed, and a monthly dollar
# cap on total high-tier spend. 0/unset disables either control. The coding
# and vision tiers get their own per-model price ceilings
# (CODING_TIER_MAX_PRICE_USD / VISION_TIER_MAX_PRICE_USD) the same way.
HIGH_TIER_MAX_PRICE_USD=5.00
CODING_TIER_MAX_PRICE_USD=5.00
VISION_TIER_MAX_PRICE_USD=5.00
HIGH_TIER_MONTHLY_BUDGET_USD=5.00
# Sublow tier: short, bounded test scenarios run at scale (hundreds of
# reenactment/testing agents). Its per-model ceiling IS the band's
# definition -- cheapest coherent model, hard-capped at $0.09/M blended.
# Leave it set; 0 disables the cap and makes sublow just duplicate low.
# Server-side experiment grants ride on this tier: an operator mints a
# rotating token with a declared cost estimate (POST /api/experiments/
# sublow/grant), the proxy serves ONLY the sublow pick and refuses once
# actual spend reaches that estimate. Grant TTL defaults to 1800s (hard
# cap 86400s); per-call token cap defaults to 600 (hard cap 4000).
SUBLOW_TIER_MAX_PRICE_USD=0.09
# JEV experiment grants ride the existing JEV resolution (the JEV_MODEL
# default in serve.py, overridable live via the /api/jev/model switch), not a
# tier band. Same grant machinery and restrictions as the sublow lane above:
# an operator mints a rotating token with a declared cost estimate (POST
# /api/experiments/jev/grant), the proxy serves ONLY the resolved JEV slug
# and refuses once actual spend reaches that estimate. Grant TTL defaults to
# 1800s (hard cap 86400s); per-call token cap defaults to 600 (hard cap
# 4000).

# Higgsfield AI API: image/video generation + editing, stored like the other
# service credentials. When both halves are set, agents get the
# generate_image / generate_video tools (SOUL V2 images, Kling 3.0 Standard
# video); generation is metered against the account's credits and accrued to
