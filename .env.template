# --- Optional sandbox/browser overrides ------------------------------------
# Container network name used by browser/session sandboxes. Blank uses the
# built-in internal network.
SANDBOX_NETWORK=
# Optional CDP URL for attaching to an already-running session Chromium.
BROWSER_CDP_URL=
# Timezone for scheduled tasks and browser sessions (e.g. America/New_York).
# Blank uses the host timezone.
TZ=
# Optimization policy mode: shadow records decisions without changing behavior;
# apply uses the routing, assignment, and retry policies. Review
# /api/optimization/policies before flipping to apply.
OPTIMIZATION_POLICY_MODE=shadow
