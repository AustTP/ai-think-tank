# Copy this file to .env at the repository root. Never commit real credentials.
# Required for remote model calls.
OPENROUTER_API_KEY=

# Optional local worker model. Leave disabled until your endpoint is ready.
LOCAL_WORK_MODEL_ENABLED=false
LOCAL_WORK_MODEL_PATH=
LOCAL_WORK_MODEL_BASE_URL=http://127.0.0.1:8888/v1
LOCAL_WORK_MODEL_API_KEY=
LOCAL_WORK_MODEL_TIMEOUT=120
LOCAL_WORK_MODEL_CONTEXT_LENGTH=8192
LOCAL_WORK_MODEL_MAX_OUTPUT_TOKENS=1500
LOCAL_WORK_MODEL_MANAGE_STUDIO=false

# Optional: set to unsloth to route ordinary worker/chat calls to Studio.
# Reviews, repairs, planning and policy decisions retain their configured models.
# PRIMARY_MODEL_PROVIDER=unsloth

# First startup generates the password hash/salt and SERVER_SECRET in .env.
# The generated admin password is printed once in the startup log.
ADMIN_USERNAME=admin
