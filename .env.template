# relay-only behaviour. cloudflare lets the sandbox driver click a Cloudflare
# Turnstile/Interstitial widget. all also lets the vision tier plan clicks on
# hCaptcha, reCAPTCHA, Friendly Captcha, and AWS WAF widgets, but only when the
# host policy is `attempt` and a live browser session holds the page.
CAPTCHA_AUTO_SOLVE=off
CAPTCHA_AGENTIC_MAX_STEPS=4
CAPTCHA_AGENTIC_CONFIDENCE=0.70
