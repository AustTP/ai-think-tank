# Secrets — never commit
.env
datasets/local/
.env_test
.env.*
!.env.template
*.bak
*.bak.*
# An exported YouTube cookies.txt for the sandbox's yt-dlp -- a full session
# credential, never tracked.
.youtube-cookies.txt

# Fernet key store for external credentials (Phase D) -- never commit keys
.secret_keys/

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Live runtime state — authoritative state lives in SQLite and regenerates
think_tank.db
think_tank.db-*
*.db
*.db-wal
*.db-shm
*.db.bak

# Agent workspaces and recovery checkpoints stay local.
sandboxes/

# Per-agent project repos are independently versioned (gitlinks, not tracked content)
agents/*/prototypes/

# Per-agent activity logs regenerate from think_tank.db and accumulate fast
# (report-<ts>-<agent>.md per completion, one player.md per conversation) --
# the durable identity files (agent.json/AGENTS.md/MEMORY.md/state.json)
# are what's worth tracking, not the runtime trail.
agents/*/reports/
agents/*/conversations/

# Team-shared space is agents' working directory -- in-progress artifacts stay
# out of the repo; finished work gets pushed/tracked deliberately in a later phase.
agents/teams/*/shared/

# Transient runtime state
escalations.json
# Server/test-runner logs and coverage residue
*.log
*.log.*
.coverage
.coverage.*
htmlcov/
coverage.xml


# macOS
.DS_Store
# Per-agent identity files: agent.json/AGENTS.md/MEMORY.md/state.json
# are MATERIALIZED MIRRORS of think_tank.db, regenerated on every save from the DB.
# Agent identities live ONLY in the database -- never tracked, never pushed.
agents/*/agent.json
agents/*/AGENTS.md
agents/*/MEMORY.md
agents/*/state.json

# Runtime state: live browse/search/usage trails and the action
# passport hash-chain are regenerated from think_tank.db at runtime -- never pushed.
browse_trail.json
library_usage.json

# Library contents, including templates and generated artifacts, stay local.
library/
# Manual pre-cleanup DB backup -- a big one-off snapshot, not source
think_tank.db.pre-cleanup-*
think-tank-db-backups/

# Disposable probe directories and coverage output.
tinyprobe_test/
world/coverage/
world/coverage.json


