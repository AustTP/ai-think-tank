# Secrets — never commit
.env
.env.*
!.env.template
*.bak
*.bak.*
# An exported YouTube cookies.txt for the sandbox's yt-dlp -- a full session
# credential, never tracked.
.youtube-cookies.txt

# Fernet key store for external credentials (Phase D) -- never commit keys
.secret_keys/

# Python
__pycache__/
*.pyc
.venv/

# Live runtime state — authoritative state lives in SQLite and regenerates
think_tank.db
think_tank.db-*
*.db
*.db-wal
*.db-shm
*.db.bak

# Sandbox project dirs are their own independent git repos — don't double-track
sandboxes/finger-drums-project/
sandboxes/research-shared/
sandboxes/workroom-shared/

# Per-agent project repos are independently versioned (gitlinks, not tracked content)
agents/*/prototypes/

# Per-agent activity logs regenerate from think_tank.db and accumulate fast
# (report-<ts>-<agent>.md per completion, one player.md per conversation) --
# the durable identity files (agent.json/AGENTS.md/MEMORY.md/state.json)
# are what's worth tracking, not the runtime trail.
agents/*/reports/
agents/*/conversations/

# Team-shared space is agents' working directory -- in-progress artifacts stay
# out of the repo; finished work gets pushed/tracked deliberately in a later phase.
agents/teams/*/shared/

# Transient runtime state
escalations.json
# Inbound webhook events (webhook consumer tail-regenerates its own view)
webhooks.jsonl
# Server/test-runner logs and coverage residue
*.log
*.log.*
.coverage

# Publish staging -- ephemeral export dir pushed to the configured private
# repo; never tracked by the main repo (may briefly hold a token)
library/publish-staging/

# macOS
.DS_Store
# Per-agent identity files: agent.json/AGENTS.md/MEMORY.md/state.json
# are MATERIALIZED MIRRORS of think_tank.db, regenerated on every save from the DB.
# Agent identities live ONLY in the database -- never tracked, never pushed.
agents/*/agent.json
agents/*/AGENTS.md
agents/*/MEMORY.md
agents/*/state.json

# Runtime state: live browse/search/usage trails and the action
# passport hash-chain are regenerated from think_tank.db at runtime -- never pushed.
browse_trail.json
library_usage.json
library/.passport.json
# Theo key registry (ask 3) -- runtime state; only key HASHES are
# persisted (raw keys are shown once at grant time), never tracked.
library/theo-keys.json

# Runtime-generated think tank content: spike findings, wiki pages,
# social/pending-review artifacts, and sandbox project dirs are all produced by
# the running think tank and carry agent-authored/agent-named content. Only the
# curated library/skills/ templates are tracked; these regenerate at runtime.
library/archive/
library/wiki/
library/social/
library/pending_review/
library/refinement/
# Player-ingested reference material (/api/library/ingest) -- runtime content
# like the other library dirs above, never tracked.
library/ingested/
# Endpoint-extracted YouTube transcripts land in the shared media/transcripts/
# tree at runtime (readable by any agent via /api/library/file) -- generated
# content, like the other runtime dirs above, never tracked.
library/media/transcripts/
world/library/media/transcripts/
# Training-capture recordings and exports (datasets/INTERACTION_RECORDING.md
# is the tracked doc; the SQLite DB and exported JSONL are runtime data).
datasets/local/
sandboxes/spike-task-*/
sandboxes/sb-*/
# Per-deliverable-story git worktrees off workroom-shared -- runtime state
# like spike-task-*, never tracked (both main-village story-<id> and the
# village-scoped <vid>-story-<id> forms).
sandboxes/story-*/
sandboxes/*-story-*/
# browser_act / HF login test sandboxes -- contain persistent browser
# profiles with live session cookies, never tracked.
sandboxes/hf-*/
# VPN sandbox tree -- holds live Mullvad relay keys.json, never tracked.
sandboxes/vpn-sandbox/
# Manual pre-cleanup DB backup -- a big one-off snapshot, not source
think_tank.db.pre-cleanup-*

# Runtime-generated think tank health/probe output and coverage artifacts --
# regenerated by the running server and the coverage harness, never tracked.
library/admin/
library/probe/
# The player's real-world identity (resume, cover letters, contact info) --
# read by agents via /api/library/file so they can act on the player's behalf,
# but NEVER tracked: this repo is public on GitHub.
library/player-profile/
tinyprobe_test/
world/coverage/
world/coverage.json
