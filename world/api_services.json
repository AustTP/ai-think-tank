{
  "version": 1,
  "comment": "Registry of external services reachable through the generic api_call tool. Adding a service here (base_url, credential source, auth, allowed paths/methods, spend rule) is the config-not-code path: no Python adapter needed. The security gates around these entries (SSRF, Jev classification, rate limit, one-strike, page/spend accrual) live in serve.py and are never delegated to this file. path_rules prefixes are matched against the URL path under base_url.",
  "services": {
    "open-meteo": {
      "name": "Open-Meteo (forecast)",
      "base_url": "https://api.open-meteo.com",
      "credential": {"type": "none"},
      "auth": {"type": "none"},
      "methods": ["GET", "HEAD"],
      "path_rules": [
        {"prefix": "/v1/", "methods": ["GET", "HEAD"]}
      ],
      "spend": {"kind": "none", "note": "free keyless public weather API -- fair-use caps (10k/day), no uptime guarantee; the think tank's reference free integration"}
    },
    "open-meteo-geocoding": {
      "name": "Open-Meteo Geocoding",
      "base_url": "https://geocoding-api.open-meteo.com",
      "credential": {"type": "none"},
      "auth": {"type": "none"},
      "methods": ["GET", "HEAD"],
      "path_rules": [
        {"prefix": "/v1/", "methods": ["GET", "HEAD"]}
      ],
      "spend": {"kind": "none", "note": "free keyless geocoding (place name -> lat/lon) backing weather lookups"}
    },
    "github": {
      "name": "GitHub",
      "base_url": "https://api.github.com",
      "credential": {"type": "env", "key": "GITHUB_TOKEN"},
      "auth": {"type": "header_bearer"},
      "default_headers": {"Accept": "application/vnd.github+json"},
      "methods": ["GET", "HEAD"],
      "path_rules": [
        {"prefix": "/", "methods": ["GET", "HEAD"]}
      ],
      "spend": {"kind": "none", "note": "free public API, rate-limited by GitHub"}
    },
    "tavily": {
      "name": "Tavily",
      "base_url": "https://api.tavily.com",
      "credential": {"type": "env", "key": "TAVILY_API_KEY"},
      "auth": {"type": "body_field", "field": "api_key"},
      "methods": ["POST"],
      "path_rules": [
        {"prefix": "/search", "methods": ["POST"]}
      ],
      "spend": {"kind": "page_request", "note": "counts one page request against the monthly budget"}
    },
    "apify": {
      "name": "Apify",
      "base_url": "https://api.apify.com/v2",
      "credential": {"type": "env", "key": "APIFY_API_KEY"},
      "auth": {"type": "header_bearer"},
      "methods": ["GET", "POST", "DELETE"],
      "path_rules": [
        {"prefix": "/users/me", "methods": ["GET"]},
        {"prefix": "/actors/", "methods": ["POST"]},
        {"prefix": "/actor-tasks/", "methods": ["POST"]},
        {"prefix": "/actor-runs/", "methods": ["GET"]},
        {"prefix": "/datasets/", "methods": ["GET", "DELETE"]}
      ],
      "spend": {"kind": "apify", "note": "budget gate before actor runs; usageTotalUsd accrued from the run object after"}
    },
    "pixellab": {
      "name": "PixelLab",
      "base_url": "https://api.pixellab.ai/v2",
      "credential": {"type": "vault", "name": "pixellab"},
      "auth": {"type": "header_bearer"},
      "methods": ["GET", "POST"],
      "path_rules": [
        {"prefix": "/", "methods": ["GET", "POST"]}
      ],
      "spend": {"kind": "none", "note": "generation is async (background-job poll); balance-delta accrual wired in phase 2"},
      "workflow": {
        "kind": "submit_poll_finalize",
        "submit": {"path_template": "/create-character-with-4-directions", "method": "POST",
                   "id_field": "background_job_id", "extra_ids": ["character_id"]},
        "poll": {"path_template": "/background-jobs/{background_job_id}", "method": "GET",
                 "id_field": "background_job_id", "interval_s": 5, "timeout_s": 95,
                 "terminal": ["completed", "failed"], "success": ["completed"]},
        "finalize": {"path_template": "/characters/{character_id}", "method": "GET"},
        "spend": {"kind": "balance_delta", "service": "pixellab", "balance_path": "/v2/balance"}
      }
    },
    "higgsfield": {
      "name": "Higgsfield",
      "base_url": "https://api.higgsfield.ai",
      "credential": {"type": "env", "key": "HIGGSFIELD_API_KEY_ID", "key2": "HIGGSFIELD_API_KEY_SECRET"},
      "auth": {"type": "header_key", "value_format": "Key {key}:{key2}"},
      "methods": ["GET", "POST"],
      "path_rules": [
        {"prefix": "/estimate/", "methods": ["POST"]},
        {"prefix": "/requests/", "methods": ["GET"]},
        {"prefix": "/higgsfield-ai/", "methods": ["POST"]},
        {"prefix": "/kling-video/", "methods": ["POST"]}
      ],
      "spend": {"kind": "none", "note": "submit/poll/accrue workflow wired in phase 2"},
      "workflow": {
        "kind": "submit_poll",
        "submit": {"path_template": "/{endpoint}", "method": "POST", "id_field": "request_id"},
        "estimate": {"path_template": "/estimate/{endpoint}", "method": "POST", "usd_field": "usd"},
        "poll": {"path_template": "/requests/{request_id}/status", "method": "GET",
                 "id_field": "request_id", "interval_s": 6, "timeout_s": 150,
                 "terminal": ["completed", "failed", "canceled", "nsfw", "age_restricted", "invalid"],
                 "success": ["completed"]},
        "spend": {"kind": "estimate_first", "service": "higgsfield"}
      }
    },
    "opensky": {
      "name": "OpenSky Network",
      "base_url": "https://opensky-network.org",
      "credential": {"type": "env", "key": "OPEN_SKY_CLIENT_ID", "key2": "OPEN_SKY_CLIENT_SECRET"},
      "auth": {"type": "oauth2_client_credentials",
              "token_url": "https://auth.opensky-network.org/auth/realms/opensky-network/protocol/openid-connect/token"},
      "methods": ["GET", "HEAD"],
      "path_rules": [
        {"prefix": "/api/", "methods": ["GET", "HEAD"]}
      ],
      "spend": {"kind": "daily_calls", "cap": 200,
                "note": "standard account: 4,000 credits/day per endpoint family (states/tracks/flights); /states/all costs 1-4 credits, /flights/* and /tracks/* cost 4+ -- cap is a conservative call count well under the real daily credit allowance"}
    },
    "adsb-lol": {
      "name": "adsb.lol (ADS-B flights)",
      "base_url": "https://api.adsb.lol",
      "credential": {"type": "none"},
      "auth": {"type": "none"},
      "methods": ["GET", "HEAD"],
      "path_rules": [
        {"prefix": "/v2/", "methods": ["GET", "HEAD"]}
      ],
      "spend": {"kind": "none", "note": "free keyless live ADS-B flight data; fair-use / rate-limited, no uptime guarantee"}
    },
    "celestrak": {
      "name": "CelesTrak (satellites)",
      "base_url": "https://celestrak.org",
      "credential": {"type": "none"},
      "auth": {"type": "none"},
      "methods": ["GET", "HEAD"],
      "path_rules": [
        {"prefix": "/NORAD/", "methods": ["GET", "HEAD"]}
      ],
      "spend": {"kind": "none", "note": "free keyless NORAD orbital-element sets (TLE); fair-use / rate-limited"}
    },
    "jina-reader": {
      "name": "Jina Reader (read-only)",
      "base_url": "https://r.jina.ai",
      "credential": {"type": "none"},
      "auth": {"type": "none"},
      "methods": ["GET", "HEAD"],
      "path_rules": [
        {"prefix": "/", "methods": ["GET", "HEAD"]}
      ],
      "spend": {"kind": "none", "note": "free keyless reader: converts any public URL into clean markdown at https://r.jina.ai/<url>; fair-use / rate-limited, no uptime guarantee -- the free read-only backend for the social channels below"}
    },
    "aisstream": {
      "name": "AISStream (ships)",
      "base_url": "https://stream.aisstream.io",
      "credential": {"type": "env", "key": "AISSTREAM_API_KEY"},
      "auth": {"type": "header_bearer"},
      "methods": ["GET"],
      "path_rules": [
        {"prefix": "/", "methods": ["GET"]}
      ],
      "spend": {"kind": "none", "note": "the live AIS feed is WebSocket-only (wss://stream.aisstream.io/v0/stream); no REST endpoint, so the HTTP api_call path cannot stream it -- this entry documents the key for a future stream collector, not a callable service today"}
    },
    "mullvad": {
      "name": "Mullvad VPN (account)",
      "base_url": "https://api.mullvad.net",
      "credential": {"type": "env", "key": "MULLVAD_ACCOUNT_NUMBER"},
      "auth": {"type": "body_field", "field": "account_number"},
      "methods": ["POST"],
      "path_rules": [
        {"prefix": "/auth/v1/token", "methods": ["POST"]}
      ],
      "spend": {"kind": "none", "note": "account/device management token endpoint only (POST /auth/v1/token mints a token from the account number) -- it cannot proxy a fetch through a country exit; the real tunnel is the CLI/WireGuard integration (serve._mullvad_*), which routes the whole machine and is not an api_call service"}
    }
  },
  "channels": {
    "comment": "Named read-only channels for platforms the think tank cannot fetch directly (server IPs are blocked). Each channel maps a set of hostnames to an ORDERED backend chain -- the first backend that answers wins, and the chain falls through on failure, mirroring agent-reach's per-platform ordered backends. Backends reference registered services (by id) plus a url_template that rewrites the requested URL into the backend's URL ({url} is the agent's original URL). Jina Reader is the free keyless backend; add a vetted credential-backed backend to a chain by appending it -- first working wins.",
    "reddit": {
      "name": "Reddit (read-only)",
      "hosts": ["reddit.com"],
      "probe_url": "https://www.reddit.com/r/programming/hot",
      "backends": [
        {"service": "jina-reader", "url_template": "https://r.jina.ai/{url}"}
      ]
    },
    "twitter": {
      "name": "Twitter/X (read-only)",
      "hosts": ["twitter.com", "x.com"],
      "probe_url": "https://x.com/the_modern_heretic",
      "backends": [
        {"service": "jina-reader", "url_template": "https://r.jina.ai/{url}"}
      ]
    },
    "linkedin": {
      "name": "LinkedIn (read-only)",
      "hosts": ["linkedin.com"],
      "probe_url": "https://www.linkedin.com/feed/",
      "backends": [
        {"service": "jina-reader", "url_template": "https://r.jina.ai/{url}"}
      ]
    }
  }
}