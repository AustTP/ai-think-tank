{
  "comment": "Need-based read-only credential access. An agent working an active task may request ONE service here by name; the server mints a short-lived handle scoped to that service's hosts and methods. No agent can enumerate the vault. readOnlyHosts is a hard browser policy: fill/click/submit are refused there; only login on an auth path is allowed. Remove a service to revoke its request path.",
  "autoGrant": {
    "google": {
      "sessionProfile": "google",
      "session": true,
      "hosts": ["google.com", "accounts.google.com", "myaccount.google.com", "youtube.com", "mail.google.com", "calendar.google.com", "drive.google.com"],
      "methods": ["GET", "POST"],
      "ttlSec": 3600
    },
    "facebook": {
      "credential": "facebook",
      "hosts": ["facebook.com", "www.facebook.com", "m.facebook.com", "mbasic.facebook.com"],
      "methods": ["POST"],
      "ttlSec": 900
    },
    "instagram": {
      "credential": "instagram",
      "hosts": ["instagram.com", "www.instagram.com"],
      "methods": ["POST"],
      "ttlSec": 900
    },
    "ideabrowser": {
      "credential": "ideabrowser_login",
      "hosts": ["ideabrowser.com", "www.ideabrowser.com"],
      "methods": ["POST"],
      "ttlSec": 3600
    }
  },
  "readOnlyHosts": [
    "facebook.com",
    "www.facebook.com",
    "m.facebook.com",
    "mbasic.facebook.com",
    "instagram.com",
    "www.instagram.com"
  ]
}
